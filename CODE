void loop()
{  

    int  S1= digitalRead(8);
    int  S2= digitalRead(9);
    int  S3= digitalRead(10); 
    int  S4= digitalRead(11);
    int  S5= digitalRead(12);
 
    int Button_Reset1 = digitalRead(Button_Reset);
    Serial.print("Bottone:");Serial.println(Button_Reset1);

    if (Button_Reset1 == HIGH)
    {
        motors.stop();
        while (Button_Reset == HIGH); // Wait until the button is released
        delay(500); // Debounce delay
        P = 0; // Reset position variable
    }

   if (Button_SW == HIGH)
    {
        int Mode = 1 - Mode; // Toggle between 0 and 1
    }
    
    int Button_SW = digitalRead(Button_SW);
    Serial.print("Mode:");Serial.println(Button_SW);

    // Print the sensor values to the Serial Monitor
    Serial.print(S1); Serial.print("  "); Serial.print(S2); Serial.print("  "); Serial.print(S3); Serial.print("  ");Serial.print(S4); Serial.print("  "); Serial.println(S5);

    if  (S3 = 0 ){
        digitalWrite(LED_G, HIGH);
    }
    else {
        digitalWrite(LED_G, LOW);
    }

    if  (S2 == 0)
    {
    P = P-1;
      Serial.print("S2");
    }

    if  (S4 == 0)
    {
    P = P+1;
    Serial.print("S4");
    }

    if  (S1 == 0){
    P = P-3;
      Serial.print("S1");
    }

    if  (S5 == 0){
      P = P+3;

      Serial.print("S5");

    }
    //  -3    -1   0   1   3

    Serial.println(P);
    switch (P){

        case -4:
            motors.setSpeed(SpeedEe);
            motors.forwardB();
            motors.backwardA();
            digitalWrite(LED_R, HIGH);
            digitalWrite(LED_Y, HIGH);

        break;

        case -3:
            motors.setSpeed(SpeedE);
            motors.forwardB();
            motors.backwardA();
            digitalWrite(LED_R, HIGH);
            digitalWrite(LED_Y, LOW);

        break;

        case -1:
            motors.setSpeed(Speede);
            motors.forwardB();
            motors.backwardA();
            digitalWrite(LED_Y, HIGH);
            digitalWrite(LED_R, LOW);

        break;

        case 0:
            motors.setSpeed(BaseSpeed);
            motors.forward();
            digitalWrite(LED_G, HIGH);
        break;

        case 1:
            motors.setSpeed(Speede);
            motors.forwardA();
            motors.backwardB();    
            digitalWrite(LED_Y, HIGH);
            digitalWrite(LED_R, LOW);
        break;

        case 3:
            motors.setSpeed(SpeedE);
            motors.forwardA();
            motors.backwardB();
            digitalWrite(LED_R, HIGH);
            digitalWrite(LED_Y, LOW);
        break;

        case 4:
            motors.setSpeed(SpeedEe);
            motors.forwardB();
            motors.backwardA();
            digitalWrite(LED_R, HIGH);
            digitalWrite(LED_Y, HIGH);

        break;

    }

    P=0;
}
