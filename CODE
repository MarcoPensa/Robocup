    {
        P-e;
    }

    if  (S4 <min)
    {
        P+e;
    }

    if  (S1 < min){
        P-E;
    }

    if  (S5 < min){
        P+E;
    }
    //  -3    -1   0   1   3

    Serial.println(P);
    switch (P){

        case -3:
            motors.setSpeed(SpeedE);
            motors.forwardB();
            motors.backwardA();
        break;

        case -1:
            motors.setSpeed(Speede);
            motors.forwardB();
            motors.backwardA();
        break;

        case 0:
            motors.setSpeed(BaseSpeed);
            motors.forward();
        break;

        case 1:
            motors.setSpeed(Speede);
            motors.forwardA();
            motors.backwardB();    
