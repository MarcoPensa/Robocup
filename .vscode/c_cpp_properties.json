{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/**",
                "C:/Users/Thinkpad-User/AppData/Local/Arduino15/packages/arduino/hardware/avr/*/cores/arduino",
                "C:/Users/Thinkpad-User/AppData/Local/Arduino15/packages/arduino/hardware/avr/*/variants/standard",
                "C:/Program Files (x86)/Arduino/hardware/arduino/avr/cores/arduino",
                "C:/Program Files (x86)/Arduino/hardware/arduino/avr/variants/standard"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_AVR_UNO"
            ],
            "compilerPath": "C:/Program Files (x86)/Arduino/hardware/tools/avr/bin/avr-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-x86"
        }
    ],
    "version": 4
}
